def clamp(value):
    return max(0.0, min(1.0, value))


def char_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def cell_width(text):
    return sum(char_width(ch) for ch in ANSI_RE.sub("", text))


def crop(text, cells):
    """Crop in terminal cells, preserving whole ANSI escapes and CJK letters."""
    cells = max(0, cells)
    result, used, pos = [], 0, 0
    while pos < len(text):
        match = ANSI_RE.match(text, pos)
        if match:
            result.append(match.group())
            pos = match.end()
            continue
        ch = text[pos]
        size = char_width(ch)
        if used + size > cells:
            break
        result.append(ch)
        used += size
        pos += 1
    if "\033[" in text:
        result.append(RESET)
    return "".join(result)


def pad(text, cells):
    text = crop(text, cells)
    return text + " " * max(0, cells - cell_width(text))


class Task:
    def __init__(self, number, spec, scale):
        self.number = number
        self.phase, self.zh, self.en, begin, end, self.result_zh, self.result_en = spec
        self.start, self.end = begin * scale, end * scale

    def fraction(self, elapsed):
        q = clamp((elapsed - self.start) / (self.end - self.start))
        # Smooth, monotonic progress with small deterministic speed changes.
        curve = 0.20 + (self.number % 5) * 0.04
        return clamp(q - curve * math.sin(2.0 * math.pi * q) / (2.0 * math.pi))

    def status(self, elapsed):
        if elapsed >= self.end:
            return "done"
        return "run" if elapsed >= self.start else "wait"


class Simulation:
    def __init__(self, duration):
        self.duration = duration
        self.scale = duration / 30.0
        self.tasks = [Task(i + 1, spec, self.scale) for i, spec in enumerate(TASKS)]
        self.events = []
        for task in self.tasks:
            self.events.append({"time": task.end, "kind": "task", "task": task,
                                "zh": task.result_zh, "en": task.result_en})
        for when, zh, en in SAMPLES:
            self.events.append({"time": when * self.scale, "kind": "sample",
                                "zh": "预设样例输出：" + zh,
                                "en": "Predefined sample output: " + en,
                                "state": en})
        self.events.sort(key=lambda item: item["time"])

    def snapshot(self, elapsed):
        elapsed = max(0.0, min(self.duration, elapsed))
        finished = elapsed >= self.duration
        views = []
        for task in self.tasks:
            # At the endpoint, force 100% to avoid scaling round-off.
            status = "done" if finished else task.status(elapsed)
            fraction = 1.0 if finished else task.fraction(elapsed)
            views.append({"task": task, "status": status, "fraction": fraction})
        phase = len(PHASES) - 1
        for i, spec in enumerate(PHASES):
            if elapsed < spec[3] * self.scale:
                phase = i
                break
        return {
            "elapsed": elapsed, "finished": finished, "phase": phase,
            "overall": clamp(elapsed / self.duration), "views": views,
            "done": sum(v["status"] == "done" for v in views),
            "active": sum(v["status"] == "run" for v in views),
            "events": [e for e in self.events if finished or e["time"] <= elapsed],
        }


class Dashboard:
    def __init__(self, args, model, color):
        self.args, self.model, self.use_color = args, model, color

    def tr(self, zh, en):
        return en if self.args.ascii else zh

    def color(self, text, name):
        return COLORS[name] + text + RESET if self.use_color else text

    def bar(self, fraction, cells, color="cyan"):
        cells = max(1, cells)
        filled = min(cells, int(clamp(fraction) * cells))
        a, b = ("#", "-") if self.args.ascii else ("█", "░")
        return self.color(a * filled, color) + self.color(b * (cells - filled), "dim")

    def phase_name(self, state):
        if state["finished"]:
            return self.tr("部署模拟完成", "SIMULATION COMPLETE")
        spec = PHASES[state["phase"]]
        return self.tr(spec[0], spec[1])

    def percent(self, state):
        return 100.0 if state["finished"] else min(99.9, state["overall"] * 100)

    def task_line(self, view, cells, elapsed):
        task, status, fraction = view["task"], view["status"], view["fraction"]
        color = {"wait": "dim", "run": "cyan", "done": "green"}[status]
        tags = {"wait": self.tr("等待", "WAIT"),
                "run": self.tr("执行", "RUN "), "done": self.tr("完成", "DONE")}
        spin = "|/-\\"[int(elapsed * 8) % 4]
        marker = "+" if status == "done" else (spin if status == "run" else ".")
        pct = 100 if status == "done" else min(99, int(fraction * 100))
        name = self.tr(task.zh, task.en)
        label_cells = min(30 if self.args.ascii else 24, max(8, cells // 3))
        left = " {} {:02d} {} ".format(marker, task.number, pad(name, label_cells))
        right = " {:3d}% {}".format(pct, tags[status])
        bar_cells = max(2, cells - cell_width(left) - cell_width(right) - 2)
        return crop(self.color(left, color) + "[" + self.bar(fraction, bar_cells, color)
                    + "]" + self.color(right, color), cells)

    def event_line(self, event, cells):
        stamp = " +{:05.1f}s [SIM] ".format(event["time"])
        message = self.tr(event["zh"], event["en"])
        color = "yellow" if event["kind"] == "sample" else "green"
        return crop(self.color(stamp + message, color), cells)

    def visible_tasks(self, state, capacity):
        views = state["views"]
        if capacity >= len(views):
            return 0, views
        pending = [i for i, view in enumerate(views) if view["status"] != "done"]
        focus = pending[0] if pending else len(views) - 1
        # Keep completed context above the running tasks; move forwards only.
        first = min(max(0, focus - 2), len(views) - capacity)
        return first, views[first:first + capacity]

    def render(self, state, cols, rows):
        w, height = max(1, cols - 1), max(1, rows - 1)
        sep = "-" if self.args.ascii else "─"
        phase = state["phase"]
        if cols < 60 or rows < 18:
            active = [v for v in state["views"] if v["status"] == "run"]
            current = self.tr(active[0]["task"].zh, active[0]["task"].en) if active else self.phase_name(state)
            lines = [self.color(self.tr("DMS 模型部署模拟 [SIM]", "DMS DEPLOYMENT [SIMULATION]"), "cyan"),
                     self.tr("仅流程展示，未运行真实部署", "Visual flow only; no real deployment"),
                     self.phase_name(state),
                     "[{bar}] {pct:5.1f}%".format(bar=self.bar(state["overall"], max(2, w - 12)), pct=self.percent(state)),
                     self.tr("步骤", "Steps") + " {}/{} | {:.1f}/{:.0f}s".format(state["done"], len(self.model.tasks), state["elapsed"], self.args.duration),
                     current,
                     self.tr("放大窗口可显示多条任务进度", "Enlarge terminal for multiple task bars"),
                     "Ctrl+C: stop"]
            return [crop(line, w) for line in lines[:height]]

        lines = [self.color(" " + self.tr("DMS 驾驶员监测系统  /  模型部署模拟", "DMS DRIVER MONITORING  /  DEPLOYMENT SIMULATION"), "cyan"),
                 self.color(" " + self.tr("SIMULATION | 仅流程展示，不安装依赖、不加载真实模型", "SIMULATION | No installation, camera access, or real model loading"), "yellow"),
                 self.color(sep * w, "dim")]
        lines.append(" " + self.tr("部署总进度", "DEPLOYMENT") + "  "
                     + self.color("{:5.1f}%".format(self.percent(state)), "cyan")
                     + "   " + self.tr("完成步骤", "STEPS") + " {}/{}".format(state["done"], len(self.model.tasks))
                     + "   " + self.tr("执行中", "ACTIVE") + " {}".format(state["active"])
                     + "   {:.1f}/{:.0f}s".format(state["elapsed"], self.args.duration))
        lines.append(" [" + self.bar(state["overall"], max(2, w - 4), "green" if state["finished"] else "cyan") + "]")

        phases = []
        for i, spec in enumerate(PHASES):
            color = "green" if state["finished"] or i < phase else ("cyan" if i == phase else "dim")
            label = self.tr(spec[0], spec[1])
            mark = "+" if state["finished"] or i < phase else (">" if i == phase else ".")
            phases.append(self.color(mark + label, color))
        trail = "  ".join(phases)
        if cell_width(trail) <= w - 2:
            lines.append(" " + trail)
        else:
            lines.append(" " + self.tr("当前阶段", "PHASE") + " {}/6  ".format(phase + 1)
                         + self.color(self.phase_name(state), "cyan"))
        lines.append(self.color(sep * w, "dim"))

        logs = 3 if rows >= 34 else 1
        # Footer: separator, phase label, events, separator, instruction.
        footer_size = 4 + logs
        capacity = max(1, height - len(lines) - 1 - footer_size)
        capacity = min(len(self.model.tasks), capacity)
        first, shown = self.visible_tasks(state, capacity)
        suffix = self.tr("  随部署阶段自动下移", "  auto-follow") if capacity < len(self.model.tasks) else ""
        lines.append(self.color(" " + self.tr("部署任务", "DEPLOYMENT TASKS")
                                + " {:02d}-{:02d}/{}".format(first + 1, first + len(shown), len(self.model.tasks)) + suffix, "white"))
        lines.extend(self.task_line(v, w, state["elapsed"]) for v in shown)
        lines.append(self.color(sep * w, "dim"))
        lines.append(" " + self.tr("当前阶段：", "PHASE: ") + self.color(self.phase_name(state), "green" if state["finished"] else "cyan")
                     + "  |  " + self.tr("下方为预设模拟记录", "PREDEFINED SIMULATION EVENTS"))
        recent = state["events"][-logs:]
        lines.extend(self.event_line(e, w) for e in recent)
        for _ in range(logs - len(recent)):
            lines.append(self.color(" " + self.tr("等待模拟任务完成...", "Waiting for simulated steps..."), "dim"))
        lines.append(self.color(sep * w, "dim"))
        footer = (self.tr("模拟完成 | 未部署真实模型、未启动真实服务", "SIMULATION COMPLETE | No real model deployed or service started")
                  if state["finished"] else self.tr("Ctrl+C 停止 | 所有进度与状态为模拟，不代表识别准确率或实测速率", "Ctrl+C: stop | Simulated progress and states; not measured accuracy or speed"))
        lines.append(self.color(" " + footer, "green" if state["finished"] else "dim"))
        return [crop(line, w) for line in lines[:height]]


class Terminal:
    """Update changed rows only. Leave the last frame visible and restore cursor."""
    def __init__(self):
        self.previous, self.size, self.active = [], None, False

    def start(self):
        self.active = True
        sys.stdout.write("\033[?25l\033[2J\033[H")
        sys.stdout.flush()

    def draw(self, lines, size):
        chunks = []
        if size != self.size:
            chunks.append("\033[2J\033[H")
            self.previous, self.size = [], size
        for i, line in enumerate(lines):
            if i >= len(self.previous) or line != self.previous[i]:
                chunks.append("\033[{};1H\033[2K{}".format(i + 1, line))
        for i in range(len(lines), len(self.previous)):
            chunks.append("\033[{};1H\033[2K".format(i + 1))
        sys.stdout.write("".join(chunks))
        sys.stdout.flush()
        self.previous = lines

    def close(self):
        if not self.active:
            return
        self.active = False
        try:
            row = min(len(self.previous) + 1, shutil.get_terminal_size((110, 38)).lines)
            sys.stdout.write("\033[0m\033[?25h\033[{};1H\033[2K".format(row))
            sys.stdout.flush()
        except (BrokenPipeError, OSError):
            pass


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description="DMS model deployment SIMULATION. No real model or system is modified.")
    parser.add_argument("--duration", type=float, default=30.0, help="simulation seconds, 1-3600 (default: 30)")
    parser.add_argument("--fps", type=int, default=12, help="dashboard refresh rate, 1-30 (default: 12)")
    parser.add_argument("--stream", action="store_true", help="scrolling completed-task bars and current-task updates")
    parser.add_argument("--plain", action="store_true", help="plain text output without terminal control codes")
    parser.add_argument("--ascii", action="store_true", help="English labels and ASCII progress bars")
    parser.add_argument("--no-color", action="store_true", help="disable colors; live positioning remains enabled")
    parser.add_argument("--report", metavar="PATH", help="optional JSON simulation report; existing files are never overwritten")
    args = parser.parse_args(argv)
    if not math.isfinite(args.duration) or not 1 <= args.duration <= 3600:
        parser.error("--duration must be a finite number from 1 to 3600")
    if not 1 <= args.fps <= 30:
        parser.error("--fps must be from 1 to 30")
    return args


def save_report(handle, model, state, exit_code, wall_time):
    result = {
        "mode": "simulation",
        "workflow": "DMS model deployment visualization",
        "real_deployment_performed": False,
        "real_inference_performed": False,
        "camera_accessed": False,
        "service_started": False,
        "network_requests": 0,
        "accuracy": None,
        "measured_inference_latency_ms": None,
        "duration_target_seconds": model.duration,
        "elapsed_wall_seconds": round(wall_time, 3),
        "simulation_completed": state["finished"] and exit_code == 0,
        "exit_code": exit_code,
        "steps_completed": state["done"],
        "steps_total": len(model.tasks),
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "steps": [{"step": v["task"].number, "name": v["task"].zh,
                   "status": v["status"], "simulated_progress": round(v["fraction"], 4)}
                  for v in state["views"]],
        "predefined_sample_states": [e["state"] for e in state["events"] if e["kind"] == "sample"],
        "note": "All tasks and outputs are scheduled examples, not deployment evidence or benchmark results.",
    }
    json.dump(result, handle, ensure_ascii=False, indent=2)
    handle.write("\n")


def main(argv=None):
    args = parse_args(argv)
    if not args.ascii:
        try:
            "模型█".encode(sys.stdout.encoding or "ascii")
        except (UnicodeEncodeError, LookupError):
            if hasattr(sys.stdout, "reconfigure"):
                sys.stdout.reconfigure(encoding="utf-8")
            else:
                args.ascii = True
    tty = sys.stdout.isatty() and os.environ.get("TERM", "") != "dumb"
    interactive = tty and not args.stream and not args.plain
    color = tty and not args.no_color and not args.plain and "NO_COLOR" not in os.environ
    model = Simulation(args.duration)
    ui = Dashboard(args, model, color)
    terminal = Terminal()
    report_handle = None
    if args.report:
        try:
            report_handle = open(args.report, "x", encoding="utf-8")
        except (OSError, ValueError) as exc:
            print("Cannot create report: {}".format(exc), file=sys.stderr)
            return 2

    start = time.monotonic()
    state = model.snapshot(0.0)
    exit_code, event_cursor, last_second = 0, 0, -1
    old_handlers = {}

    def stop(_signum, _frame):
        raise KeyboardInterrupt

    try:
        for name in ("SIGTERM", "SIGHUP"):
            if hasattr(signal, name):
                sig = getattr(signal, name)
                old_handlers[sig] = signal.signal(sig, stop)
        if interactive:
            terminal.start()
        else:
            print(ui.tr("DMS 模型部署模拟 | SIMULATION | 未运行真实部署", "DMS DEPLOYMENT SIMULATION | NO REAL DEPLOYMENT"), flush=True)
        while True:
            elapsed = time.monotonic() - start
            state = model.snapshot(elapsed)
            if interactive:
                size = shutil.get_terminal_size((110, 38))
                terminal.draw(ui.render(state, size.columns, size.lines), size)
            else:
                for event in state["events"][event_cursor:]:
                    if event["kind"] == "task" and args.stream:
                        view = {"task": event["task"], "fraction": 1.0, "status": "done"}
                        print("[SIM] " + ui.task_line(view, 86, state["elapsed"]).lstrip(), flush=True)
                    else:
                        print(ui.event_line(event, 140).lstrip(), flush=True)
                event_cursor = len(state["events"])
                second = int(elapsed)
                if second != last_second or state["finished"]:
                    print("[SIM] {name} [{bar}] {pct:5.1f}% | {done}/{total} | {t:.1f}/{duration:g}s".format(
                        name=ui.phase_name(state), bar=ui.bar(state["overall"], 24), pct=ui.percent(state),
                        done=state["done"], total=len(model.tasks), t=state["elapsed"], duration=args.duration), flush=True)
                    if args.stream:
                        for view in state["views"]:
                            if view["status"] == "run":
                                print("[SIM] " + ui.task_line(view, 86, state["elapsed"]).lstrip(), flush=True)
                    last_second = second
            if state["finished"]:
                break
            time.sleep(min(1.0 / args.fps, max(0.0, args.duration - elapsed)))
    except KeyboardInterrupt:
        exit_code = 130
        state = model.snapshot(time.monotonic() - start)
    except (BrokenPipeError, OSError):
        exit_code = 1
        state = model.snapshot(time.monotonic() - start)
    finally:
        terminal.close()
        for sig, handler in old_handlers.items():
            signal.signal(sig, handler)
        if report_handle:
            try:
                save_report(report_handle, model, state, exit_code, time.monotonic() - start)
            except (OSError, ValueError) as exc:
                exit_code = 1
                print("Cannot write simulation report: {}".format(exc), file=sys.stderr)
            finally:
                report_handle.close()
    try:
        if exit_code == 0:
            print(ui.color(ui.tr("DMS 部署模拟完成：24/24 步骤。未加载真实模型，未启动真实服务。", "DMS deployment simulation complete: 24/24 steps. No real model loaded or service started."), "green"))
        elif exit_code == 130:
            print(ui.tr("DMS 部署模拟已停止，终端已恢复。", "DMS deployment simulation stopped. Terminal restored."))
        if report_handle:
            print(ui.tr("模拟报告：", "Simulation report: ") + args.report)
    except (BrokenPipeError, OSError):
        pass
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
