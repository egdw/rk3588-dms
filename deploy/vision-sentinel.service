[Unit]
Description=Vision Sentinel DMS backend
After=network.target

[Service]
Type=simple
User=ztl
WorkingDirectory=/home/ztl/code/vision-sentinel
Environment=VISION_SENTINEL_HOST=0.0.0.0
Environment=VISION_SENTINEL_HTTPS=1
Environment=VISION_SENTINEL_OPEN_BROWSER=0
ExecStart=/home/ztl/code/vision-sentinel/start-backend.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
